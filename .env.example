# WhisperX Environment Variables Example
# Copy this file to .env and add your actual values

# HuggingFace Access Token (required for optimal speaker diarization)
# Get your token from: https://huggingface.co/settings/tokens
# Make sure to accept user agreements for:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your_token_here

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual token
# 3. Run evaluation: python tests/comprehensive_evaluation.py